// Test Requests for Virtual Event Management Platform API

// ============= USER ENDPOINTS =============

// 1. Register a new user (Attendee)
POST http://localhost:5000/api/users/register
Content-Type: application/json

{
  "email": "john@example.com",
  "name": "John Doe",
  "password": "Password123!",
  "role": "attendee"
}

### Register organizer
POST http://localhost:5000/api/users/register
Content-Type: application/json

{
  "email": "organizer@example.com",
  "name": "Event Organizer",
  "password": "Password123!",
  "role": "organizer"
}

### Login user
POST http://localhost:5000/api/users/login
Content-Type: application/json

{
  "email": "john@example.com",
  "password": "Password123!"
}

### Get user profile
GET http://localhost:5000/api/users/profile
Authorization: Bearer YOUR_JWT_TOKEN_HERE

// ============= EVENT ENDPOINTS =============

### Get all events (Public)
GET http://localhost:5000/api/events

### Get single event
GET http://localhost:5000/api/events/1

### Create event (Organizer only)
POST http://localhost:5000/api/events/create
Authorization: Bearer YOUR_ORGANIZER_JWT_TOKEN
Content-Type: application/json

{
  "title": "Web Development Bootcamp",
  "description": "Learn modern web development with React, Node.js, and MongoDB",
  "date": "2024-02-20",
  "time": "10:00",
  "maxParticipants": 50
}

### Create another event
POST http://localhost:5000/api/events/create
Authorization: Bearer YOUR_ORGANIZER_JWT_TOKEN
Content-Type: application/json

{
  "title": "Cloud Computing Masterclass",
  "description": "Deep dive into AWS, Azure, and GCP",
  "date": "2024-03-01",
  "time": "14:30",
  "maxParticipants": 30
}

### Update event (Organizer only)
PUT http://localhost:5000/api/events/1
Authorization: Bearer YOUR_ORGANIZER_JWT_TOKEN
Content-Type: application/json

{
  "title": "Advanced Web Development Bootcamp",
  "date": "2024-02-22",
  "time": "09:00"
}

### Delete event (Organizer only)
DELETE http://localhost:5000/api/events/1
Authorization: Bearer YOUR_ORGANIZER_JWT_TOKEN

### Get organizer's events
GET http://localhost:5000/api/events/organizer/my-events
Authorization: Bearer YOUR_ORGANIZER_JWT_TOKEN

// ============= EVENT REGISTRATION ENDPOINTS =============

### Register user for event
POST http://localhost:5000/api/events/1/register
Authorization: Bearer YOUR_USER_JWT_TOKEN

### Get user's registered events
GET http://localhost:5000/api/events/user/registered-events
Authorization: Bearer YOUR_USER_JWT_TOKEN

### Cancel event registration
POST http://localhost:5000/api/events/1/cancel-registration
Authorization: Bearer YOUR_USER_JWT_TOKEN

// ============= HEALTH CHECK =============

### Health check
GET http://localhost:5000/api/health

// ============= NOTES =============
// 1. Replace YOUR_JWT_TOKEN_HERE with actual token from login/register response
// 2. Replace YOUR_ORGANIZER_JWT_TOKEN with organizer's token
// 3. Replace YOUR_USER_JWT_TOKEN with regular user's token
// 4. Replace event ID (1, 2, etc.) with actual event IDs
// 5. Tokens expire after 7 days
// 6. Only organizers can create, update, and delete events
